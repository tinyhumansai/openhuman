/result
/result-*
.direnv/

tauri.key
tauri.key.pub
/target/
/crates/*/target/
src-tauri/target/
app/src-tauri-mobile/gen/
app/src-tauri-mobile/target/
.target-codex/

workflow
.fastembed_cache
overlay/src-tauri/target/
.claude/*.lock
app/.claude/scheduled_tasks.lock
# Subagent lifecycle checkpoints written by crate-local test runs that have no
