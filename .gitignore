# Coverage/diff-cover artifacts (generated locally, never shipped)
lcov*.info
diff-coverage.md

# CI lane runner output (scripts/ci/self-hosted/lanes.mjs)
/ci-out/

# Local/self-hosted CI run output (never commit)
ci-out/
ci-out-ex63/

